{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Schema for PCS database metadata",
  "definitions": {
    "BodyPart": {
      "type": "object",
      "description": "Body parts affected by PCS.",
      "properties": {
        "Crown": {"type": "number"},
        "Head": {"type": "number"},
        "Left_Chest": {"type": "number"},
        "Right_Chest": {"type": "number"},
        "Left_Back": {"type": "number"},
        "Right_Back": {"type": "number"},
        "Abdomen": {"type": "number"},
        "Buttocks": {"type": "number"},
        "Left_Upper_Arm": {"type": "number"},
        "Right_Upper_Arm": {"type": "number"},
        "Left_Forearm": {"type": "number"},
        "Right_Forearm": {"type": "number"},
        "Left_Hand": {"type": "number"},
        "Right_Hand": {"type": "number"},
        "Left_Front_Thigh": {"type": "number"},
        "Right_Front_Thigh": {"type": "number"},
        "Left_Back_Thigh": {"type": "number"},
        "Right_Back_Thigh": {"type": "number"},
        "Left_Lower_Leg": {"type": "number"},
        "Right_Lower_Leg": {"type": "number"},
        "Left_Foot": {"type": "number"},
        "Right_Foot": {"type": "number"}
      }
    }
  },
  "properties": {
    "columns": {
      "type": "object",
      "description": "Metadata for each column in the PCS database CSV",
      "properties": {
        "ID": {"type": "integer", "description": "Unique identifier for each PCS."},
        "Category": {"type": "string", "description": "Category of the PCS (e.g., cooling, heating)."},
        "Type": {"type": "string", "description": "Type of PCS (e.g., fan, vest)."},
        "Brand": {"type": "string", "description": "Brand name of the PCS."},
        "PCS_Reference": {"type": "string", "description": "Reference number or model identifier of PCS."},
        "PCS_Intensity": {"type": "string", "description": "Intensity level of the PCS."},
        "Price_USD": {"type": "number", "description": "Price of the PCS in US dollars."},
        "Angle": {"type": "number", "description": "Angle of the PCS air or radiation.", "unit": "degrees"},
        "Distance": {"type": "number", "description": "Distance from PCS to target.", "unit": "m"},
        "Target_Body": {"type": "string", "description": "Targeted body region for PCS application."},
        "Power_W": {"type": "number", "description": "Power consumption of the PCS.", "unit": "W"},
        "DateTime": {"type": "string", "format": "date-time", "description": "Timestamp of data entry."},
        "Place": {"type": "string", "description": "Location where the measurement was taken."},
        "Posture": {"type": "string", "description": "Posture of the manikin during measurement (e.g., standing, sitting)."},
        "Situation": {"type": "string", "description": "Description of the environment where PCS is used (e.g., office, car)."},
        "Manikin_Company": {"type": "string", "description": "Manufacturer of the thermal manikin used."},
        "Manikin_Gender": {"type": "string", "enum": ["Male", "Female"], "description": "Gender representation of the thermal manikin."},
        "Manikin_Body_Segments": {"type": "integer", "description": "Number of body segments modeled in the thermal manikin."},
        "Control_Method": {"type": "string", "description": "Method used to control the PCS (e.g., manual, automatic)."},
        "Ta": {"type": "number", "description": "Ambient air temperature.", "unit": "°C"},
        "MRT": {"type": "number", "description": "Mean radiant temperature.", "unit": "°C"},
        "RH": {"type": "number", "description": "Relative humidity.", "unit": "%"},
        "V": {"type": "number", "description": "Air velocity.", "unit": "m/s"},
        "Delta_Teq": {
          "type": "object",
          "description": "Equivalent temperature change for specific body parts.",
          "$ref": "#/definitions/BodyPart"
        },
        "Delta_P": {
          "type": "object",
          "description": "Change in perceived temperature or power supply for specific body parts.",
          "$ref": "#/definitions/BodyPart"
        },
        "Clo": {
          "type": "object",
          "description": "Clothing insulation value for specific body parts.",
          "$ref": "#/definitions/BodyPart"
        },
        "Image_Path": {"type": "string", "description": "File path of related images."}
      }
    }
  },
  "examples": [
    {
      "ID": 1,
      "Category": "Fan",
      "Type": "Small desk fan",
      "Brand": "Simpeak",
      "PCS_Reference": "Reference link",
      "PCS_Intensity": "Low",
      "Price_USD": 10,
      "Angle": 125.0,
      "Distance": 60.0,
      "Target_Body": "Face",
      "Power_W": 2,
      "DateTime": "2025-02-01T17:18:00Z",
      "Place": "The University of Sydney",
      "Posture": "Sitting",
      "Situation": "Office",
      "Manikin_Company": "PT Manikins",
      "Manikin_Gender": "Female",
      "Manikin_Body_Segments": 22,
      "Control_Method": "TskControl34",
      "Ta": 25,
      "MRT": 25,
      "RH": 50,
      "V": 0.1
    }
  ],
  "required": ["columns"]
}
