{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "BodyPart": {
      "type": "object",
      "description": "Body parts affected by PCS.",
      "properties": {
        "Crown": {"type": "number"},
        "Head": {"type": "number"},
        "Left_Chest": {"type": "number"},
        "Right_Chest": {"type": "number"},
        "Left_Back": {"type": "number"},
        "Right_Back": {"type": "number"},
        "Abdomen": {"type": "number"},
        "Buttocks": {"type": "number"},
        "Left_Upper_Arm": {"type": "number"},
        "Right_Upper_Arm": {"type": "number"},
        "Left_Forearm": {"type": "number"},
        "Right_Forearm": {"type": "number"},
        "Left_Hand": {"type": "number"},
        "Right_Hand": {"type": "number"},
        "Left_Front_Thigh": {"type": "number"},
        "Right_Front_Thigh": {"type": "number"},
        "Left_Back_Thigh": {"type": "number"},
        "Right_Back_Thigh": {"type": "number"},
        "Left_Lower_Leg": {"type": "number"},
        "Right_Lower_Leg": {"type": "number"},
        "Left_Foot": {"type": "number"},
        "Right_Foot": {"type": "number"}
      }
    }
  },
  "properties": {
    "columns": {
      "type": "object",
      "description": "Metadata for each column in the PCS database CSV",
      "properties": {
        "ID": {"type": "integer", "description": "Unique identifier for each PCS.", "example": 1},
        "Category": {"type": "string", "enum": ["Cooling", "Heating"], "description": "Category of the PCS.", "example": "Cooling"},
        "Type": {"type": "string", "enum": ["Cooling", "Heating"], "description": "Type of PCS (e.g., fan, foot warmer).", "example": "Small desk fan"},
        "Brand": {"type": "string", "description": "Brand name of the PCS.", "example": "Simpeak"},
        "PCS_Reference": {"type": "string", "description": "Reference URL of PCS.", "example": "Reference link"},
        "PCS_Intensity": {"type": "string", "description": "Intensity level of the PCS.", "example": "Low"},
        "Price_USD": {"type": "number", "description": "Price of the PCS in US dollars.", "example": 10},
        "Angle": {"type": "number", "description": "Angle of the PCS and target (degrees).", "example": 125.0},
        "Distance": {"type": "number", "description": "Distance from PCS to target (m).", "example": 60.0},
        "Target_Body": {"type": "string", "description": "Targeted body segment for PCS application.", "example": "Face"},
        "Power_W": {"type": "number", "description": "Energy consumption of the PCS (W).", "example": 2},
        "DateTime": {"type": "string", "format": "date-time", "description": "Timestamp of data entry.", "example": "2025-02-01T17:18:00Z"},
        "Place": {"type": "string", "description": "Location where the measurement was taken.", "example": "The University of Sydney"},
        "Posture": {"type": "string", "description": "Posture of the manikin during measurement (e.g., standing, sitting).", "example": "Sitting"},
        "Situation": {"type": "string", "description": "Description of the environment where PCS is used (e.g., office, car).", "example": "Office"},
        "Manikin_Company": {"type": "string", "description": "Manufacturer of the thermal manikin used.", "example": "PT Manikins"},
        "Manikin_Gender": {"type": "string", "enum": ["Male", "Female"], "description": "Gender representation of the thermal manikin.", "example": "Female"},
        "Manikin_Body_Segments": {"type": "integer", "description": "Number of body segments of the thermal manikin.", "example": 22},
        "Control_Method": {"type": "string", "enum": ["TskControl", "HeatFluxControl", "ComfortControl"], "description": "Method used to control the PCS (e.g., manual, automatic).", "example": "TskControl"},
        "Ta": {"type": "number", "description": "Ambient air temperature (°C).", "example": 25},
        "MRT": {"type": "number", "description": "Mean radiant temperature (°C).", "example": 25},
        "RH": {"type": "number", "description": "Relative humidity (%).", "example": 50},
        "V": {"type": "number", "description": "Air velocity (m/s).", "example": 0.1},
        "Delta_Teq_": {
          "type": "object",
          "description": "Equivalent temperature change for specific body parts.",
          "$ref": "#/definitions/BodyPart"
        },
        "Delta_P_": {
          "type": "object",
          "description": "Change in perceived temperature or power supply for specific body parts.",
          "$ref": "#/definitions/BodyPart"
        },
        "Clo_": {
          "type": "object",
          "description": "Clothing insulation value for specific body parts.",
          "$ref": "#/definitions/BodyPart"
        },
        "Image_Path": {"type": "string", "description": "File path of related images."}
      }
    }
  },
  "required": ["columns"]
}
